# Rust
# Cargo.lock is committed: this crate ships a binary, and CI builds and tests it
# with --locked so the published binary is built from reviewed dependencies.
target/

# Node and Python wrapper build and test artifacts
node_modules/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# IDE
.idea/
*.iml
.vscode/
.windsurf/

# Secrets
*.env
.secure_files/*
!.secure_files/
!.secure_files/*.example
cache.config
credentials.config
endpoint.config

# Native binaries and their checksum manifest (built by CI via cargo-zigbuild
# for every configured target, never committed). The plugin's test fixtures
# under src/test/resources/native/ are committed and unaffected.
runtime/scala/sbt-plugin/src/main/resources/native/

# The shared libraries the language runtimes load in-process: CI's build-rust
# job produces them here, and each package's build copies them in.
runtime/native/
runtime/node/native-lib/
runtime/python/src/paste_assetgraph/native-lib/

# Generated into an sdist by setup.py; never committed to the source tree.
runtime/python/BUILD_VERSION

# The publish jobs stage the repository's license texts beside each package
# manifest; the committed copies live only at the repository root.

# The macOS SDK cache and fresh extraction used by the Darwin build job
.macos-sdk/
.macos-sdk-current/
.release-assets/

# Output of the determinism fixture build
features/dist/

# The build's write lock — tooling state at the project root, never an asset
manifest.lock

# OS
.DS_Store
Thumbs.db
